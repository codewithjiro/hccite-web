{
  "name": "hccite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "lint": "eslint .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "pnpm test:auth && pnpm test:db && pnpm test:discovery && pnpm test:citation && pnpm test:studies && pnpm test:analysis && pnpm test:literature && pnpm test:integrity && pnpm test:rrl && pnpm test:rrl-audit && pnpm test:dashboard",
    "test:auth": "node --experimental-strip-types --test tests/auth-boundary.test.mjs",
    "test:db": "node --experimental-strip-types --import ./tests/db-test-loader.mjs --test tests/db-integration.test.mjs",
    "test:discovery": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/discovery.test.mjs",
    "test:citation": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/citation.test.mjs tests/saved-indicator.test.mjs",
    "test:studies": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/study-upload.test.mjs tests/study-deletion.test.mjs",
    "test:analysis": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/study-analysis.test.mjs && node --experimental-strip-types --import ./tests/db-test-loader.mjs --test tests/study-processing-db.test.mjs",
    "test:literature": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/literature.test.mjs",
    "test:integrity": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/integrity.test.mjs",
    "test:rrl": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/rrl.test.mjs",
    "test:rrl-audit": "node --experimental-strip-types --import ./tests/discovery-test-loader.mjs --test tests/rrl-audit.test.mjs && node --experimental-strip-types --import ./tests/db-test-loader.mjs --test tests/rrl-audit-db.test.mjs",
    "test:dashboard": "node --experimental-strip-types --import ./tests/db-test-loader.mjs --test tests/dashboard-db.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@clerk/nextjs": "^7.9.4",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@uploadthing/react": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "drizzle-orm": "^0.41.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "next": "^15.2.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.19.0"
}
