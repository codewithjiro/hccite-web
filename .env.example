# Final Phase 12 environment contract. Never commit a populated .env file.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# PostgreSQL / Drizzle
# Format: postgresql://USER:PASSWORD@localhost:5432/hccite
DATABASE_URL=

# Academic search and DOI lookup
# Server-only. Add the same name in Vercel Project Settings for deployed environments.
OPENALEX_API_KEY=
CROSSREF_MAILTO=
GOOGLE_BOOKS_API_KEY=

# Uploads; free-plan files are accessible by URL
UPLOADTHING_TOKEN=
MAX_STUDY_FILE_MB=50

# AI analysis and writing
# Server-only. Keep the key in .env.local or Vercel Project Settings; never use NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# HCCite
INTEGRITY_CHECK_TTL_HOURS=24
