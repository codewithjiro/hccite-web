# Phase 01 runs without credentials. Add these as their phases begin.
# Never commit a populated .env file.

# Phase 02: Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Phase 03: PostgreSQL / Drizzle
# Format: postgresql://USER:PASSWORD@localhost:5432/hccite
DATABASE_URL=

# Phase 04: academic search and DOI lookup
OPENALEX_API_KEY=
CROSSREF_MAILTO=
GOOGLE_BOOKS_API_KEY=

# Phase 06: uploads; free-plan files are accessible by URL
UPLOADTHING_TOKEN=
MAX_STUDY_FILE_MB=50

# Phase 07 onward: AI analysis and writing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
